# Zoom App credentials from the Marketplace build flow.
ZM_CLIENT_ID=
ZM_CLIENT_SECRET=

# Must exactly match "Redirect URL for OAuth" on the app registration,
# and be listed in the OAuth Allow List. Note the /api prefix.
#   dev:  https://<your-ngrok-subdomain>.ngrok.io/api/auth
#   prod: https://<your-project>.vercel.app/api/auth
ZM_REDIRECT_URL=

# Signs the short-lived cookie that carries OAuth state + PKCE verifier
# between /api/install and /api/auth. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret Token from the app's Feature > Event Subscriptions page. Verifies
# that a call to /api/deauthorize is genuinely Zoom's, and answers the
# url_validation challenge Zoom sends when you save the endpoint.
ZM_WEBHOOK_SECRET_TOKEN=

# Optional. Space-separated OAuth scopes, and only ever a subset of what the
# registration was granted -- asking for one it was not fails the whole
# authorize with error 4700. Left empty, Zoom grants the app's configured
# scopes, which is what you want unless you have a reason otherwise.
ZM_SCOPES=
