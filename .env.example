# Zoom App credentials from the Marketplace build flow.
ZM_CLIENT_ID=
ZM_CLIENT_SECRET=

# Must exactly match "Redirect URL for OAuth" on the app registration,
# and be listed in the OAuth Allow List. Note the /api prefix.
#   dev:  https://<your-ngrok-subdomain>.ngrok.io/api/auth
#   prod: https://<your-project>.vercel.app/api/auth
ZM_REDIRECT_URL=

# Signs the short-lived cookie that carries OAuth state + PKCE verifier
# between /api/install and /api/auth. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
